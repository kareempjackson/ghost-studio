# Sanity — copy to .env.local and fill in. projectId and dataset are on sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Viewer token: draft previews and live editing. Never give it more than Viewer.
SANITY_API_READ_TOKEN=

# Editor token: only scripts/seed.ts uses it. Keep it out of the deployed env.
SANITY_API_WRITE_TOKEN=

# Shared with the GROQ webhook on sanity.io/manage that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Cloudflare R2 — where the films live. Create an R2 API token with Object Read
# & Write on the bucket (R2 > Manage API tokens); the account ID is on the R2
# overview. The public URL is the bucket's custom domain or its r2.dev URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# The site's public address, e.g. https://www.ghostsavvy.com. Canonical links,
# share cards and the sitemap point here. Unset, Vercel's own address is used
# (the production domain in production), and localhost locally: lib/site.ts.
SITE_URL=

# The contact form. A message is stored in Sanity as an enquiry, and the sender
# and the studio are emailed through Resend.
#   SANITY_API_FORM_TOKEN: an Editor token made for the form alone (sanity.io/
#     manage > API > Tokens), so it can be revoked on its own.
#   RESEND_API_KEY: resend.com > API Keys. Verify the sending domain there
#     (a few DNS records) or mail from it will not be delivered.
#   CONTACT_FROM: who the emails come from, on that verified domain. The
#     studio's address in Site settings if unset.
SANITY_API_FORM_TOKEN=
RESEND_API_KEY=
CONTACT_FROM="Ghost Savvy Studios <hello@ghostsavvy.com>"

# The site guide (app/api/guide): its answers are written by Claude.
#   ANTHROPIC_API_KEY: console.anthropic.com > API Keys. Set a monthly spend
#     limit on its workspace. Unset, the guide offers its shortlist and the
#     brief, and takes no questions.
#   GUIDE_SECRET: optional. What the conversation's turns are sealed with; the
#     API key is used if unset. Any long random string.
#   REDIS_KV_REST_API_URL, REDIS_KV_REST_API_TOKEN: where the guide counts
#     its questions (lib/guide/limit.ts). Vercel > Storage > Upstash for Redis
#     sets them, with the REDIS prefix this project chose; the unprefixed
#     KV_REST_API_ or UPSTASH_REDIS_REST_ names work too. In production the
#     guide takes no questions without them.
ANTHROPIC_API_KEY=
GUIDE_SECRET=
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=

# PostHog — public browser analytics configuration. The site routes browser
# requests through its /ingest proxy (next.config.ts).
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# The Studio's Analytics tool (sanity/analytics.tsx): GA4, Search Console and
# Lighthouse, read through /api/analytics, for editors only. Its keys are
# pasted into Analytics keys in the Studio (under Site settings), kept at a
# private id the public dataset doesn't show; which properties they read is
# set in Site settings › Tracking. These are used only for a key left empty
# there, and are optional:
#   GA_SERVICE_ACCOUNT_EMAIL, GA_PRIVATE_KEY: a Google service account's
#     client_email and private_key, quoted, with the \n left in.
#   PAGESPEED_API_KEY: a Google Cloud API key for the PageSpeed Insights API.
# The server reads Analytics keys with SANITY_API_READ_TOKEN.
GA_SERVICE_ACCOUNT_EMAIL=
GA_PRIVATE_KEY=
PAGESPEED_API_KEY=
