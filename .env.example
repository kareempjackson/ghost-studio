# Sanity — copy to .env.local and fill in. projectId and dataset are on sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Viewer token: draft previews and live editing. Never give it more than Viewer.
SANITY_API_READ_TOKEN=

# Editor token: only scripts/seed.ts uses it. Keep it out of the deployed env.
SANITY_API_WRITE_TOKEN=

# Shared with the GROQ webhook on sanity.io/manage that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
